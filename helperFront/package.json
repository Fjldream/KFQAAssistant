{
  "name": "helper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:meta": "node genMeta.js",
    "build": "npm run build:widget && npm run generate:meta && rspress build && node create-entry.mjs",
    "dev": "npm run build:widget && npm run generate:meta && rspress dev",
    "format": "prettier --write .",
    "preview": "rspress preview --host 0.0.0.0",
    "test:widget": "vitest run widget/src",
    "build:widget": "node widget/build.mjs",
    "dev:widget": "node widget/build.mjs --watch"
  },
  "dependencies": {
    "@rspress/core": "^2.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/jsdom": "^21.1.7",
    "esbuild": "^0.25.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0"
  }
}
