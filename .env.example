# 应用运行环境：local/dev/test/production。
APP_ENV=local

# API 访问密钥；本地开发默认关闭认证，生产环境建议配置。
APP_API_KEY=
DISABLE_AUTH=true
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8080,http://localhost:8080

# DeepSeek 大模型配置。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_JUDGE_MODEL=deepseek-v4-flash
DEEPSEEK_JUDGE_TIMEOUT_SECONDS=60
EVALUATION_SEMANTIC_ENABLED=true

# 本地 embedding、文档目录和向量库配置。
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
CHROMA_PERSIST_DIR=storage/chroma
INDEX_MANIFEST_PATH=storage/processed/index_manifest.json
DATA_DIR=data/help
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# 检索和图片返回控制。
TOP_K=5
RETRIEVAL_MAX_CHUNKS_PER_SOURCE=2
MAX_IMAGES_PER_SOURCE=5
MAX_IMAGES_PER_ANSWER=8
ENABLE_QUERY_REWRITE=false
QUERY_REWRITE_MAX_QUERIES=3
MULTI_QUERY_CANDIDATE_LIMIT=50

# 连续对话速度控制：完整问题跳过改写，摘要默认每 3 轮更新一次。
ENABLE_CONVERSATION_REWRITE=true
ENABLE_CONVERSATION_SUMMARY=true
CONVERSATION_SUMMARY_EVERY_N_TURNS=3

# Demo 页面和压测脚本调用的问答接口地址。
KF_RAG_API_URL=http://127.0.0.1:8000/api/chat
# RAG 评测系统配置。
EVALUATION_DB_PATH=storage/evaluation/kingiask_eval.db
EVALUATION_CASES_PATH=backend/evaluation_cases/core.v1.json
EVALUATION_DIALOGUES_PATH=backend/evaluation_cases/eval_dialogues.json
EVALUATION_FAIL_UNDER=0.85
EVALUATION_MAX_P95_MS=30000
# 可信发布门禁默认启用三个 Judge 指标；Judge 固定使用 Flash 非思考模式。
EVALUATION_SEMANTIC_ENABLED=true
EVALUATION_METRICS=answer_correctness,required_fact_coverage,faithfulness,hit_at_k,recall_at_k,mrr,chunk_hit_at_k,forbidden_source_matches
EVALUATION_PRICE_INPUT_CACHE_HIT_PER_MILLION=0
EVALUATION_PRICE_INPUT_CACHE_MISS_PER_MILLION=0
EVALUATION_PRICE_OUTPUT_PER_MILLION=0
