# 应用运行环境：local/dev/test/production。
APP_ENV=local

# API 访问密钥；本地开发默认关闭认证，生产环境建议配置。
APP_API_KEY=
DISABLE_AUTH=true
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:3000,http://localhost:3000

# DeepSeek 大模型配置。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60

# 本地 embedding、文档目录和向量库配置。
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
CHROMA_PERSIST_DIR=storage/chroma
INDEX_MANIFEST_PATH=storage/processed/index_manifest.json
DATA_DIR=data/help
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# 检索和图片返回控制。
TOP_K=5
MAX_IMAGES_PER_SOURCE=5
MAX_IMAGES_PER_ANSWER=8
ENABLE_QUERY_REWRITE=true
QUERY_REWRITE_MAX_QUERIES=5
MULTI_QUERY_CANDIDATE_LIMIT=50

# Demo 页面和压测脚本调用的问答接口地址。
KF_RAG_API_URL=http://127.0.0.1:8000/api/chat
